{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "Hotel": {
    "TimeZone": "Asia/Bishkek"
  },
  "Jwt": {
    "Issuer": "hms-api",
    "Audience": "hms",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "Identity": {
    "PublicWebUrl": "http://localhost:3000",
    "RequireConfirmedEmailForGuests": true
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromAddress": "no-reply@hms.local"
  },
  "RateLimiting": {
    "AuthStrictPerMinute": 10,
    "AuthRefreshPerMinute": 60,
    "PublicSearchPerMinute": 60,
    "GuestBookingPerMinute": 10
  },
  "GuestBookings": {
    "MaxActiveWebBookingsPerGuest": 3
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false
  },
  "AllowedHosts": "*"
}
