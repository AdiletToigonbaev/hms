# PRODUCTION. Скопируйте в deploy/.env.production (не коммитится; права 600) и задайте значения.
# Секреты генерируйте на сервере: openssl rand -base64 48   (для паролей БД — openssl rand -hex 24)
# Подробно: docs/development/deployment.md.

# Домен сайта (DNS A-запись → IP сервера) и email для уведомлений Let's Encrypt
DOMAIN=hotel.example.com
# Дополнительные имена через пробел (у каждого — своя A-запись) → редирект 301 на DOMAIN; сертификат — на все.
DOMAIN_ALIASES=www.hotel.example.com
LETSENCRYPT_EMAIL=admin@example.com

# PostgreSQL: владелец схемы (миграции, бэкап) и роль приложения (под ней работает API)
POSTGRES_DB=hms
POSTGRES_USER=hms_owner
POSTGRES_PASSWORD=
APP_DB_USER=hms_app
APP_DB_PASSWORD=

# Ключ подписи JWT (не короче 32 байт). Смена ключа завершит все сессии.
JWT_SIGNING_KEY=

# Почта (SMTP почтового провайдера гостиницы). SMTP_SECURITY: StartTls (порт 587) или SslOnConnect (465)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
# Имя отправителя; пусто — название гостиницы из настроек («Great Hotel»)
SMTP_FROM_NAME=

# Первый владелец — создаётся командой migrate, если владельца ещё нет. Пароль временный:
# смена при первом входе. После первого релиза строку OWNER_PASSWORD можно очистить.
OWNER_FULL_NAME=Владелец
OWNER_EMAIL=
OWNER_PHONE=
OWNER_PASSWORD=

# WhatsApp Business Platform (Cloud API). Пусто — WhatsApp выключен, уведомления уходят письмами.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Резервные копии: ежедневно в BACKUP_TIME (Asia/Bishkek), шифрование — публичным ключом age.
# Ключи: age-keygen -o hms-age-identity.txt (на компьютере владельца, НЕ на сервере);
# сюда — строка «Public key: age1...». Можно несколько ключей через пробел.
BACKUP_AGE_RECIPIENT=
BACKUP_TIME=03:30
BACKUP_RETENTION_DAYS=14
BACKUP_HOST_DIR=/var/backups/hms
# Копия вне сервера (rclone): имя remote из deploy/rclone/rclone.conf и папка, например offsite:hms-backups
RCLONE_REMOTE=
BACKUP_REMOTE_RETENTION_DAYS=30
# Приватный ключ age — кладётся на сервер только на время восстановления
AGE_IDENTITY_HOST_FILE=/home/hms/hms-age-identity.txt
