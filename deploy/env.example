# Скопируйте в deploy/.env и задайте свои значения. Файл .env не коммитится.
# Значения ниже — только для локальной разработки.
POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms_dev_only
POSTGRES_PORT=5432

# Ключ подписи JWT: случайная строка не короче 32 символов (например: openssl rand -base64 48)
JWT_SIGNING_KEY=dev-only-signing-key-do-not-use-in-production-0123456789

# Адрес сайта для ссылок в письмах
PUBLIC_WEB_URL=http://localhost:3000

# Первый владелец (создаётся сервисом migrate, если владельца ещё нет; пароль сменить при первом входе)
OWNER_FULL_NAME=Владелец
OWNER_EMAIL=owner@hms.local
OWNER_PASSWORD=owner-dev-password
