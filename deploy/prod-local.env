# НЕ ДЛЯ СЕРВЕРА. Окружение для проверки production-сборки локально и в CI (https://localhost,
# самоподписанный сертификат, Mailpit). Значения ниже — тестовые и публичные; на сервере — deploy/.env.production.
DOMAIN=localhost
DOMAIN_ALIASES=www.localhost
LETSENCRYPT_EMAIL=admin@example.com
POSTGRES_DB=hms
POSTGRES_USER=hms_owner
POSTGRES_PASSWORD=prod-local-owner-password
APP_DB_USER=hms_app
APP_DB_PASSWORD=prod-local-app-password
JWT_SIGNING_KEY=prod-local-signing-key-only-for-local-checks-0123456789
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Гостиница
OWNER_FULL_NAME=Владелец
OWNER_EMAIL=owner@hms.local
OWNER_PASSWORD=owner-prod-local-password
# Ключ age генерирует deploy/prod-local-check.sh в deploy/backups/ (не в git) и передаёт
# публичную часть переменной окружения BACKUP_AGE_RECIPIENT.
BACKUP_TIME=03:30
BACKUP_HOST_DIR=./backups
AGE_IDENTITY_HOST_FILE=./backups/test-age-identity.txt
